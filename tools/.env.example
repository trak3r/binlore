# =================================================================
# Binlore Tools Environment Configuration (.env)
# Copy this file to tools/.env: cp tools/.env.example tools/.env
# =================================================================

# Google AI Studio API key (required for lore extraction, not for transcribe-all)
# Free tier: https://aistudio.google.com/apikey
# Do not attach a billing account.
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini model (optional, default: gemini-3.6-flash)
# If Flash daily quota is tiny, switch to Flash-Lite:
# GEMINI_MODEL="gemini-3.6-flash-lite"
GEMINI_MODEL="gemini-3.6-flash"

# Hugging Face Access Token (Optional, recommended for remote/cloud servers)
# When faster-whisper downloads model weights (e.g. Systran/faster-whisper-small),
# Hugging Face imposes strict rate limits on unauthenticated IPs (especially on cloud VPS).
# Setting HF_TOKEN enables higher bandwidth, eliminates 429 rate-limiting, and silences warnings.
# Create a free "Read" token at https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_token_here"

# Whisper / transcription (CPU). "Killed" with no Python traceback = Linux OOM.
# Long VODs (e.g. 8h Deb-8) are split into chunks so full PCM is never in RAM.
# WHISPER_CHUNK_SECONDS=14400  # only chunk VODs longer than 4h; 0 = never chunk
# WHISPER_BEAM_SIZE=1
# WHISPER_CPU_THREADS=4
# WHISPER_VAD=1
# WHISPER_FORCE_MODEL=0   # set to 1 to disable auto-downgrade (may OOM)

# YouTube bot-check cooldown. Temporary IP/session throttles usually clear
# if you stop hammering. Defaults: wait 1h, then probe every 30m.
# YTDLP_BOT_COOLDOWN_INITIAL=3600
# YTDLP_BOT_COOLDOWN_PROBE=1800
# Pace metadata requests (default 1s) so bulk archive downloads trip less often:
# YTDLP_SLEEP_REQUESTS=1
# Optional YouTube extractor overrides (rarely needed):
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv,android_vr
